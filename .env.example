# Variables de entorno del frontend (Vite). Copiar a `.env` y ajustar.
# IMPORTANTE: todo lo que empiece con VITE_ termina visible en el navegador.
# Nunca poner aquí claves secretas (solo claves públicas / URLs).

# true = usar datos simulados de src/example/ para el LOGIN (funciona sin backend).
# false = usar el backend real de autenticación configurado en VITE_API_URL.
# Ya NO controla el chat (ver VITE_CHAT_MOCK).
VITE_USE_MOCKS=true

# URL base del backend FastAPI de autenticación. Solo se usa cuando VITE_USE_MOCKS=false.
VITE_API_URL=http://localhost:8000

# URL base del agente real que atiende POST /chat. Vacía = usar el default de
# producción (https://agent.ustacode.codefest2026.augusta.avaldigitallabs.com).
# En local puede apuntar a http://localhost:8000.
VITE_AGENT_URL=

# true = el chat usa el mock de src/example/chat.mock.ts en vez del agente real.
# Por defecto false: el chat consume el agente real.
VITE_CHAT_MOCK=false

# Clave PÚBLICA de reCAPTCHA v2. Esta es la clave de pruebas de Google
# (siempre pasa, no usar en producción). La clave secreta vive solo en el backend.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
